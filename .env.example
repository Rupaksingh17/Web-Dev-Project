# Set this to the ApiUrl output from the deployed SAM stack.
# Without it, the report board and form will show a service-configuration error.
NEXT_PUBLIC_API_BASE_URL=

# Set these from the SAM stack outputs to enable customer and administrator sign-in.
NEXT_PUBLIC_COGNITO_DOMAIN=
NEXT_PUBLIC_COGNITO_CLIENT_ID=
# Example: http://localhost:3000/admin/callback/ (registered by the SAM stack)
NEXT_PUBLIC_COGNITO_REDIRECT_URI=
